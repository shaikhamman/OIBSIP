<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VerveCraft Studio — Modern Web & Brand Craft</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <header class="navbar">
    <div class="container nav-inner">
      <a href="#top" class="brand">VerveCraft</a>
      <nav aria-label="Primary Navigation">
        <ul class="nav-links">
          <li><a href="#features">Features</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
      <a href="#contact" class="btn btn-sm">Get Started</a>
    </div>
  </header>

  <main id="top">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-content">
          <span class="eyebrow">Design &amp; Front-End Studio</span>
          <h1>Clean, responsive interfaces built to convert.</h1>
          <p class="hero-sub">
            We craft fast, accessible, and visually balanced web experiences that turn casual visitors into loyal customers.
          </p>
          <div class="hero-actions">
            <a href="#features" class="btn">Explore Features</a>
            <a href="#about" class="btn btn-outline">Learn More</a>
          </div>
        </div>
        <div class="hero-card" aria-hidden="true">
          <div class="card-badge">99.9% Uptime Ready</div>
          <h2>Pixel-Accurate Layouts</h2>
          <p>Structured with modern CSS Grid and Flexbox for consistent rendering across screens.</p>
        </div>
      </div>
    </section>

    <section id="features" class="section features-section">
      <div class="container">
        <div class="section-header">
          <h2>Core Features</h2>
          <p>Everything needed for a clear, high-trust digital presence.</p>
        </div>
        <div class="feature-grid">
          <article class="feature-card">
            <h3>Responsive by Default</h3>
            <p>Adapts smoothly from compact mobile screens to wide desktop displays without layout breaks.</p>
          </article>
          <article class="feature-card">
            <h3>Fast &amp; Lightweight</h3>
            <p>Semantic HTML5 and clean CSS3 ensure quick load times and predictable spacing.</p>
          </article>
          <article class="feature-card">
            <h3>Clear Visual Hierarchy</h3>
            <p>Distinct headings, balanced contrast, and focused calls to action guide user attention.</p>
          </article>
        </div>
      </div>
    </section>

    <section id="about" class="section about-section">
      <div class="container about-box">
        <div>
          <h2>About VerveCraft</h2>
          <p>
            VerveCraft focuses on practical front-end architecture, readable typography, and clutter-free visual design. Every section is spaced deliberately so users can scan information effortlessly.
          </p>
        </div>
      </div>
    </section>
  </main>

  <footer id="contact" class="footer">
    <div class="container footer-inner">
      <div>
        <strong>VerveCraft Studio</strong>
        <p>hello@vervecraft.example • +91 98000 00000</p>
      </div>
      <div class="social-links">
        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://x.com" target="_blank" rel="noopener noreferrer">X</a>
      </div>
    </div>
  </footer>
</body>
</html>
